----
import {
 "moonbitlang/async@0.22.5",
 "moonbitlang/async@0.22.5/shell",
 "moonbitlang/async@0.22.5/fs",
 "moonbitlang/core/env",
}
----
async fn command(args : Array[String], success : Bool) -> Unit {
  let r = @shell.Cmd("moon",args).output()
  println(r.stdout()); println(r.stderr())
  guard (r.exit_code()==0) == success else { abort("unexpected CLI result") }
}
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  command(["run","samples/make_template.mbtx"],true)
  command(["run","samples/make_choices.mbtx"],true)
  let dir = @fs.tmpdir(prefix="formferry-e2e-")
  let output = dir + "/completed.pdf"
  let base = ["run","bin/formferry","--target",target,"--"]
  command(base + ["fields","samples/project.pdf"],true)
  command(base + ["fill","samples/project.pdf","samples/project.json",output],true)
  let original = @fs.read_file(output).binary()
  command(base + ["values",output],true)
  command(base + ["check","samples/project.pdf"],false)
  command(base + ["check",output],true)
  command(base + ["complete","samples/project.pdf","samples/project.json",dir+"/complete.pdf"],true)
  command(base + ["fill","samples/project.pdf","samples/project.json",output],false)
  assert_eq(@fs.read_file(output).binary(),original)
  let bad = dir + "/bad.json"
  let refused = dir + "/refused.pdf"
  command(base + ["fill","samples/project.pdf","samples/fit.json",refused],false)
  assert_false(@fs.exists(refused))
  command(base + ["complete","samples/project.pdf","samples/fit.json",dir+"/fitted.pdf","--fit-text"],true)
  command(base + ["values",dir+"/fitted.pdf"],true)
  @fs.write_file(bad,"{\"project\":\"draft\"}")
  command(base + ["complete","samples/project.pdf",bad,refused],false)
  assert_false(@fs.exists(refused))
  assert_false(@fs.exists(refused+".formferry-part"))
  @fs.write_file(bad,"{\"missing\":true}")
  command(base + ["fill","samples/project.pdf",bad,refused],false)
  assert_false(@fs.exists(refused))
  assert_false(@fs.exists(refused+".formferry-part"))
  @fs.write_file(bad,"{\"project\":\"中文\"}")
  command(base + ["fill","samples/project.pdf",bad,refused],false)
  assert_false(@fs.exists(refused))
  command(base + ["fill","samples/project.pdf","samples/project.json","samples/project.pdf"],false)
  let batch = dir + "/batch"
  command(base + ["batch","samples/choices.pdf","samples/batch.json",batch],true)
  assert_true(@fs.exists(batch+"/0001.pdf"))
  assert_true(@fs.exists(batch+"/0002.pdf"))
  command(base + ["batch","samples/choices.pdf","samples/batch.json",batch],false)
  let rejected_batch = dir + "/bad-batch"
  @fs.write_file(bad,"[{\"project\":\"valid\"},{\"missing\":true}]")
  command(base + ["batch","samples/choices.pdf",bad,rejected_batch],false)
  assert_false(@fs.exists(rejected_batch))
  assert_false(@fs.exists(rejected_batch+".formferry-part"))
  let csv_batch = dir + "/csv-batch"
  command(base + ["batch-csv-complete","samples/choices.pdf","samples/batch.csv",csv_batch],true)
  assert_true(@fs.exists(csv_batch+"/0002.pdf"))
  command(base + ["values",csv_batch+"/0002.pdf"],true)
  @fs.write_file(bad,"project,owner,approved\nValid,owner,true\nBad,owner,yes")
  let bad_csv = dir + "/bad-csv"
  command(base + ["batch-csv","samples/project.pdf",bad,bad_csv],false)
  assert_false(@fs.exists(bad_csv))
  assert_false(@fs.exists(bad_csv+".formferry-part"))
  println("CLI verified; result: " + output)
}
