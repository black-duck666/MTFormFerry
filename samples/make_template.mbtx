----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/encoding/utf8",
}
----
async fn main {
  let objects = [
    "<< /Type /Catalog /Pages 2 0 R /AcroForm 4 0 R >>",
    "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 300] /Resources << /Font << /F1 9 0 R >> >> /Contents 10 0 R /Annots [5 0 R 6 0 R 7 0 R 8 0 R] >>",
    "<< /Fields [5 0 R 6 0 R 7 0 R 8 0 R] /DR << /Font << /F1 9 0 R >> >> /DA (/F1 12 Tf 0 g) >>",
    "<< /Subtype /Widget /FT /Tx /T (project) /Rect [90 210 550 235] >>",
    "<< /Subtype /Widget /FT /Tx /T (owner) /Rect [90 160 550 185] >>",
    "<< /Subtype /Widget /FT /Tx /T (source) /Rect [90 110 550 135] >>",
    "<< /Subtype /Widget /FT /Btn /T (approved) /Rect [90 60 110 80] /AS /Off /V /Off /AP << /N << /Off 11 0 R /Yes 12 0 R >> >> >>",
    "<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>",
  ]
  let page = "BT /F1 16 Tf 30 265 Td (Project registration) Tj /F1 12 Tf 0 -45 Td (Project) Tj 0 -50 Td (Owner) Tj 0 -50 Td (Source) Tj 0 -50 Td (Approved) Tj ET\n"
  let off = "0 0 20 20 re S\n"
  let on = "0 0 20 20 re S 3 10 m 8 4 l 17 17 l S\n"
  objects.push("<< /Length \{page.length()} >> stream\n\{page}endstream")
  for content in [off,on] {
    objects.push("<< /Type /XObject /Subtype /Form /BBox [0 0 20 20] /Length \{content.length()} >> stream\n\{content}endstream")
  }
  let out = StringBuilder()
  out.write_string("%PDF-1.4\n")
  let offsets = []
  for i,obj in objects { offsets.push(out.to_string().length()); out.write_string("\{i+1} 0 obj\n\{obj}\nendobj\n") }
  let start = out.to_string().length()
  out.write_string("xref\n0 \{objects.length()+1}\n0000000000 65535 f \n")
  for offset in offsets { let d = offset.to_string(); out.write_string("0".repeat(10-d.length())+d+" 00000 n \n") }
  out.write_string("trailer\n<< /Size \{objects.length()+1} /Root 1 0 R >>\nstartxref\n\{start}\n%%EOF\n")
  @fs.write_file("samples/project.pdf",@utf8.encode(out.to_string()))
}
